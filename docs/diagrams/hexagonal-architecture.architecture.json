  "cards": [
    {
      "dot": "violet",
      "title": "Arquitectura Hexagonal (Puertos y Adaptadores)",
      "items": [
        "Propuesta por Alistair Cockburn (2005) para aislar la lógica de negocio",
        "El núcleo no sabe si la petición viene de HTTP, consola o pruebas automatizadas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inversión de Dependencias (DIP)",
      "items": [
        "Application define IProductRepository (Puerto de Salida)",
        "Infrastructure implementa IProductRepository (Adaptador Secundario) invirtiendo la flecha"
      ]
    },
    {
      "dot": "cyan",
      "title": "Testeabilidad sin Infraestructura",
      "items": [
        "El núcleo se prueba al 100% con mocks de los puertos de salida",
        "No se requiere base de datos ni servidor web para validar reglas de negocio"
      ]
    }
  ]
