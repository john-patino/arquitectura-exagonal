      {
        "id": "inbound-path",
        "label": "Flujo de Entrada (Driving / Primario)",
        "focus": ["client", "driving_adapter", "inbound_port", "domain_core"],
        "note": "El cliente invoca el adaptador primario (Web API) que traduce la petición y llama al puerto de entrada (caso de uso CQRS)."
      },
      {
        "id": "outbound-path",
        "label": "Flujo de Salida y Persistencia (Driven)",
        "focus": ["domain_core", "outbound_port", "driven_adapter", "database"],
        "note": "El núcleo interactúa exclusivamente mediante interfaces (puertos de salida); el adaptador de infraestructura persiste en PostgreSQL."
      },
      {
        "id": "complete-hexagon",
        "label": "Topología Completa del Hexágono",
        "focus": ["client", "driving_adapter", "inbound_port", "domain_core", "outbound_port", "driven_adapter", "database"],
        "note": "Aislamiento total del núcleo (Hexágono Interior) frente a adaptadores y tecnologías externas (Hexágono Exterior)."
      }
    ]
  },
